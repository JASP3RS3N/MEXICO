# Backend configuration — copy to backend/.env and adjust.
MONGO_URL=mongodb://localhost:27017
DB_NAME=smokehouse
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=*
# Set to true to seed a full demo tenant (owner/cashier/prep users + settings +
# smokehouse catalog, all under one tenant_id) on first boot. Off by default.
SEED_DEMO_TENANT=false

# --- AI assistant (LM Studio, owner-only) ---
AI_ENABLED=true
# Same machine: http://host.docker.internal:1234/v1 (Docker) or http://localhost:1234/v1 (bare metal).
# Tailscale peer: http://100.x.x.x:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Optional: pin a model id; empty uses whatever LM Studio has loaded.
LMSTUDIO_MODEL=
LMSTUDIO_API_KEY=lm-studio

# --- Email (SMTP) — optional, para enviar el PIN de acceso a empleados ---
# Deja SMTP_USER/SMTP_PASSWORD vacíos para desactivar el envío (el PIN igual se muestra en la app).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Smokehouse OS

# --- Bank terminal webhook + low-stock alerts ---
# Shared secret the terminal webhook requires (Clip / Mercado Pago / n8n).
PAYMENTS_WEBHOOK_SECRET=cambia-este-secreto
# Optional: outbound webhook fired on low-stock (point to n8n for WhatsApp/email). Empty = in-app only.
ALERT_WEBHOOK_URL=
