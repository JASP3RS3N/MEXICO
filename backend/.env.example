# Backend configuration — copy to backend/.env and adjust.
MONGO_URL=mongodb://localhost:27017
DB_NAME=smokehouse
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=*
# Set to true to seed a full demo tenant (owner/cashier/prep users + settings +
# smokehouse catalog, all under one tenant_id) on first boot. Off by default.
SEED_DEMO_TENANT=false

# --- AI assistant (LM Studio, owner-only) ---
AI_ENABLED=true
# Same machine: http://host.docker.internal:1234/v1 (Docker) or http://localhost:1234/v1 (bare metal).
# Tailscale peer: http://100.x.x.x:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Optional: pin a model id; empty uses whatever LM Studio has loaded.
LMSTUDIO_MODEL=
LMSTUDIO_API_KEY=lm-studio
# Optional: Firecrawl web search/scrape for the assistant, via LM Studio's
# ephemeral MCP integration (LM Studio 0.4.0+). Empty = feature off, chat
# behaves exactly as without Firecrawl. Self-hosted instance, no auth needed.
FIRECRAWL_MCP_URL=http://localhost:3010/mcp

# --- Email (SMTP) — optional, para enviar el PIN de acceso a empleados ---
# Deja SMTP_USER/SMTP_PASSWORD vacíos para desactivar el envío (el PIN igual se muestra en la app).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Smokehouse OS

# --- Fiscal (CFDI 4.0 / FiscalAPI) — cifrado de credenciales ---
# Llave simétrica (Fernet) usada para cifrar fiscalapi_api_key / fiscalapi_tenant_key
# antes de guardarlas. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Requerida por backend/crypto_utils.py; sin ella el módulo falla al importarse.
FISCAL_ENCRYPTION_KEY=

# --- Bank terminal webhook + low-stock alerts ---
# Shared secret the terminal webhook requires (Clip / Mercado Pago / n8n).
PAYMENTS_WEBHOOK_SECRET=cambia-este-secreto
# Optional: outbound webhook fired on low-stock (point to n8n for WhatsApp/email). Empty = in-app only.
ALERT_WEBHOOK_URL=

# --- WMS Producción ↔ Almacén: ingesta de inventario SAP (SOLO LECTURA) ---
# Un script externo (SAP GUI Scripting / RFC, corrido por el Task Scheduler de
# Windows) exporta MB52 a esta carpeta cada hora. La app SOLO LEE ese archivo:
# no hay ninguna llamada de escritura hacia SAP en todo el proyecto.
SAP_INVENTORY_ENABLED=true
# Ruta a la carpeta compartida (dentro del contenedor si usas Docker; monta la
# carpeta de red ahí en docker-compose.yml).
SAP_INVENTORY_EXPORT_PATH=/data/sap_export
# Patrón de archivos a considerar; se toma el más reciente por fecha de modificación.
SAP_INVENTORY_FILE_GLOB=*.*
# Cada cuántos minutos relee la carpeta el scheduler interno.
SAP_INVENTORY_SYNC_MINUTES=60
# Tenant dueño del export. Vacío = el único tenant existente (caso normal en planta).
SAP_INVENTORY_TENANT_SLUG=
# Cómo se arma la locación: "plant" (solo centro/WERKS) o "plant_sloc" (centro + almacén/LGORT).
SAP_LOCATION_MODE=plant
# Mapeo de columnas del export. Vacío = autodetección por alias (MB52 en inglés
# y español ya está cubierto). Llénalos solo si tu archivo usa otros nombres.
SAP_COL_PART_NUMBER=
SAP_COL_DESCRIPTION=
SAP_COL_PLANT=
SAP_COL_STORAGE_LOCATION=
SAP_COL_QTY=
SAP_COL_UOM=
# Separador decimal del export: "auto" lo deduce del propio archivo; "." o ","
# lo fijan si tu export resulta ambiguo.
SAP_DECIMAL_SEPARATOR=auto
